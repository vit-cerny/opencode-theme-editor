{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "glassPanel": "#0f1115d9",
    "glassElement": "#171a21bf",
    "glassMenu": "#12151bd9",
    "glassBorder": "#ffffff26",
    "glassBorderSubtle": "#ffffff14",
