    "glassElementLight": "#f2f4f7bf",
    "glassMenuLight": "#ffffffe6",
    "glassBorderLight": "#00000026",
    "glassBorderSubtleLight": "#00000014",
    "accent": "#fab283",
    "accentLight": "#3b7dd8",
    "secondary": "#5c9cf5",
    "secondaryLight": "#7b5bb6",
    "tertiary": "#9d7cd8",
    "tertiaryLight": "#d68c27",
    "red": "#e06c75",
    "redLight": "#d1383d",
    "orange": "#f5a742",
    "orangeLight": "#d68c27",
    "green": "#7fd88f",
    "greenLight": "#3d9a57",
    "cyan": "#56b6c2",
    "cyanLight": "#318795",
    "yellow": "#e5c07b",
    "yellowLight": "#b0851f",
    "fg": "#eeeeee",
    "fgLight": "#1a1a1a",
    "fgMuted": "#9aa0a6",
    "fgMutedLight": "#5f6368",
    "diffAdd": "#4fd6be",
    "diffAddLight": "#1e725c",
    "diffDel": "#c53b53",
    "diffDelLight": "#c53b53",
    "diffCtx": "#828bb8",
    "diffCtxLight": "#7086b5",
    "diffAddHi": "#b8db87",
    "diffAddHiLight": "#4db380",
    "diffDelHi": "#e26a75",
    "diffDelHiLight": "#f52a65",
    "diffAddBg": "#4fd6be2e",
    "diffDelBg": "#c53b532e",
    "diffAddNumBg": "#4fd6be1f",
    "diffDelNumBg": "#c53b531f",
    "lineNum": "#8f8f8f",
    "lineNumLight": "#595959"
  },
  "theme": {
    "primary": { "dark": "accent", "light": "accentLight" },
    "secondary": { "dark": "secondary", "light": "secondaryLight" },
    "accent": { "dark": "tertiary", "light": "tertiaryLight" },
    "error": { "dark": "red", "light": "redLight" },
    "warning": { "dark": "orange", "light": "orangeLight" },
    "success": { "dark": "green", "light": "greenLight" },
    "info": { "dark": "cyan", "light": "cyanLight" },
    "text": { "dark": "fg", "light": "fgLight" },
    "textMuted": { "dark": "fgMuted", "light": "fgMutedLight" },
    "selectedListItemText": { "dark": "fg", "light": "fgLight" },
    "background": { "dark": "none", "light": "none" },
    "backgroundPanel": { "dark": "glassPanel", "light": "glassPanelLight" },
    "backgroundElement": { "dark": "glassElement", "light": "glassElementLight" },
    "backgroundMenu": { "dark": "glassMenu", "light": "glassMenuLight" },
    "border": { "dark": "glassBorder", "light": "glassBorderLight" },
    "borderActive": { "dark": "accent", "light": "accentLight" },
    "borderSubtle": { "dark": "glassBorderSubtle", "light": "glassBorderSubtleLight" },
    "diffAdded": { "dark": "diffAdd", "light": "diffAddLight" },
    "diffRemoved": { "dark": "diffDel", "light": "diffDelLight" },
    "diffContext": { "dark": "diffCtx", "light": "diffCtxLight" },
    "diffHunkHeader": { "dark": "diffCtx", "light": "diffCtxLight" },
    "diffHighlightAdded": { "dark": "diffAddHi", "light": "diffAddHiLight" },
    "diffHighlightRemoved": { "dark": "diffDelHi", "light": "diffDelHiLight" },
    "diffAddedBg": { "dark": "diffAddBg", "light": "#d5e5d5b3" },
    "diffRemovedBg": { "dark": "diffDelBg", "light": "#f7d8dbb3" },
    "diffContextBg": { "dark": "glassElement", "light": "glassElementLight" },
    "diffLineNumber": { "dark": "lineNum", "light": "lineNumLight" },
    "diffAddedLineNumberBg": { "dark": "diffAddNumBg", "light": "#c5d5c5b3" },
    "diffRemovedLineNumberBg": { "dark": "diffDelNumBg", "light": "#e7c8cbb3" },
    "markdownText": { "dark": "fg", "light": "fgLight" },
    "markdownHeading": { "dark": "tertiary", "light": "tertiaryLight" },
    "markdownLink": { "dark": "accent", "light": "accentLight" },
    "markdownLinkText": { "dark": "cyan", "light": "cyanLight" },
    "markdownCode": { "dark": "green", "light": "greenLight" },
    "markdownBlockQuote": { "dark": "yellow", "light": "yellowLight" },
    "markdownEmph": { "dark": "yellow", "light": "yellowLight" },
    "markdownStrong": { "dark": "orange", "light": "orangeLight" },
    "markdownHorizontalRule": { "dark": "fgMuted", "light": "fgMutedLight" },
    "markdownListItem": { "dark": "accent", "light": "accentLight" },
    "markdownListEnumeration": { "dark": "cyan", "light": "cyanLight" },
    "markdownImage": { "dark": "accent", "light": "accentLight" },
    "markdownImageText": { "dark": "cyan", "light": "cyanLight" },
    "markdownCodeBlock": { "dark": "fg", "light": "fgLight" },
    "syntaxComment": { "dark": "fgMuted", "light": "fgMutedLight" },
    "syntaxKeyword": { "dark": "tertiary", "light": "tertiaryLight" },
    "syntaxFunction": { "dark": "accent", "light": "accentLight" },
    "syntaxVariable": { "dark": "red", "light": "redLight" },
    "syntaxString": { "dark": "green", "light": "greenLight" },
    "syntaxNumber": { "dark": "orange", "light": "orangeLight" },
    "syntaxType": { "dark": "yellow", "light": "yellowLight" },
    "syntaxOperator": { "dark": "cyan", "light": "cyanLight" },
    "syntaxPunctuation": { "dark": "fg", "light": "fgLight" },
    "thinkingOpacity": 0.35
  }
}
